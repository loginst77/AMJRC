# Copy to .env and fill in the values below.
#   cp .env.example .env

# Old (source) repo — the subdomain, e.g. "church-website" from church-website.prismic.io
OLD_REPO=church-website

# New (destination) repo — e.g. "amjrc" from amjrc.prismic.io
NEW_REPO=amjrc

# Migration API token from the NEW repo:
#   amjrc → Settings > API & Security > Migration API token
NEW_REPO_WRITE_TOKEN=

# Only needed if the OLD repo is private. Leave blank otherwise.
OLD_REPO_ACCESS_TOKEN=

# Optional: restrict which custom types migrate (comma-separated).
# You can also pass this inline: TYPES=blog_post node migrate.js
# TYPES=blog_post
